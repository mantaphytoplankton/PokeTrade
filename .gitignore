# dependencies
/node_modules

# testing
/coverage
/test-results
/playwright-report
/.e2e-data

# local JSON persistence — never commit real user data (tech-spec.md: no DB,
# local JSON under data/ only)
/data

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.next-dev.pid
.next-dev.log

# credentials / keys — defense in depth beyond the env patterns below
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Claude Code local-only settings (personal permission overrides, not shared config)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real keys. Ignore every .env variant (bare .env,
# .env.local, .env.production, .env.production.local, ...), not just the
# *.local ones — Next.js loads all of them, so any could hold real secrets.
# .env.example is explicitly un-ignored below as the safe, values-free template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
